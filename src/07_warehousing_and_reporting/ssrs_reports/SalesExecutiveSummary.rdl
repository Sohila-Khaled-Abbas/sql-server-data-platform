<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>OmniFlow Enterprise Sales Executive Summary Report</Description>
  <Author>Data Platform DBRE Team</Author>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="OmniFlowDW_DataSource">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost;Initial Catalog=OmniFlowDW;Integrated Security=True</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>58b3f4d1-7662-4328-98e3-44146014949a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="ds_SalesPerformance">
      <Query>
        <DataSourceName>OmniFlowDW_DataSource</DataSourceName>
        <CommandType>Text</CommandType>
        <CommandText>
          SELECT 
              d.CalendarYear,
              d.MonthName,
              d.MonthNumberOfYear,
              p.CategoryName,
              p.ProductName,
              COUNT(DISTINCT f.OrderIdBK) AS TotalOrders,
              SUM(f.Quantity) AS UnitsSold,
              SUM(f.GrossAmount) AS GrossRevenue,
              SUM(f.DiscountAmount) AS DiscountsGiven,
              SUM(f.NetAmount) AS NetRevenue,
              SUM(f.MarginAmount) AS GrossProfitMargin
          FROM dw.FactSales f
          JOIN dw.DimDate d ON f.DateKey = d.DateKey
          JOIN dw.DimProduct p ON f.ProductSK = p.ProductSK
          WHERE d.FullDate &gt;= @StartDate AND d.FullDate &lt;= @EndDate
            AND (@CategoryName = 'ALL' OR p.CategoryName = @CategoryName)
          GROUP BY 
              d.CalendarYear,
              d.MonthName,
              d.MonthNumberOfYear,
              p.CategoryName,
              p.ProductName
          ORDER BY d.CalendarYear, d.MonthNumberOfYear, NetRevenue DESC;
        </CommandText>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CategoryName">
            <Value>=Parameters!CategoryName.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="CalendarYear"><DataField>CalendarYear</DataField></Field>
        <Field Name="MonthName"><DataField>MonthName</DataField></Field>
        <Field Name="MonthNumberOfYear"><DataField>MonthNumberOfYear</DataField></Field>
        <Field Name="CategoryName"><DataField>CategoryName</DataField></Field>
        <Field Name="ProductName"><DataField>ProductName</DataField></Field>
        <Field Name="TotalOrders"><DataField>TotalOrders</DataField></Field>
        <Field Name="UnitsSold"><DataField>UnitsSold</DataField></Field>
        <Field Name="GrossRevenue"><DataField>GrossRevenue</DataField></Field>
        <Field Name="DiscountsGiven"><DataField>DiscountsGiven</DataField></Field>
        <Field Name="NetRevenue"><DataField>NetRevenue</DataField></Field>
        <Field Name="GrossProfitMargin"><DataField>GrossProfitMargin</DataField></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="StartDate">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>2024-01-01T00:00:00</Value>
        </Values>
      </DefaultValue>
      <Prompt>Select Start Date:</Prompt>
    </ReportParameter>
    <ReportParameter Name="EndDate">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>=Today()</Value>
        </Values>
      </DefaultValue>
      <Prompt>Select End Date:</Prompt>
    </ReportParameter>
    <ReportParameter Name="CategoryName">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>ALL</Value>
        </Values>
      </DefaultValue>
      <Prompt>Select Product Category:</Prompt>
    </ReportParameter>
  </ReportParameters>
  <ReportSections>
    <ReportSection>
      <Body>
        <Height>3.5in</Height>
        <ReportItems>
          <Textbox Name="ReportTitle">
            <Top>0.2in</Top>
            <Left>0.2in</Left>
            <Width>7.5in</Width>
            <Height>0.5in</Height>
            <Value>Enterprise Sales &amp; Revenue Executive Summary</Value>
            <Style>
              <FontFamily>Segoe UI</FontFamily>
              <FontSize>18pt</FontSize>
              <FontWeight>Bold</FontWeight>
              <Color>#1B365D</Color>
            </Style>
          </Textbox>
        </ReportItems>
      </Body>
      <Width>8.5in</Width>
      <Page>
        <PageHeight>11in</PageHeight>
        <PageWidth>8.5in</PageWidth>
        <LeftMargin>0.5in</LeftMargin>
        <RightMargin>0.5in</RightMargin>
        <TopMargin>0.5in</TopMargin>
        <BottomMargin>0.5in</BottomMargin>
      </Page>
    </ReportSection>
  </ReportSections>
</Report>
